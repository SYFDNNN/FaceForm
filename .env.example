# Face Shape Classifier — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env with real secrets to git!

# ── Required ──────────────────────────────────────────────────────────────────
# Comma-separated API keys for /api/predict authentication
# Generate keys with: python manage.py create_api_key
API_KEY_LIST=dev-key-change-me

# Path to the PyTorch model file (.pth)
MODEL_PATH=face_shape_model.pth

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development          # development | production
PORT=5000

# ── Limits ────────────────────────────────────────────────────────────────────
# Max upload size in bytes (8MB = 8388608)
MAX_CONTENT_LENGTH=8388608

# Rate limit per IP (flask-limiter format)
RATE_LIMIT=60 per minute

# ── Gunicorn ──────────────────────────────────────────────────────────────────
WORKERS=4                      # Number of gunicorn workers
THREADS=2                      # Threads per worker
TIMEOUT=120                    # Worker timeout in seconds

# ── Redis (optional — for distributed rate limiting) ──────────────────────────
# If not set, falls back to in-memory storage (not shared across workers)
# REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                 # debug | info | warning | error
